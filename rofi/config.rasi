@import "colors.rasi"
configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-filebrowser:        "";
    display-window:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    run-command: "{cmd}";
    run-shell-command: "{terminal} -e {cmd}";

}


* {
    font: "Iosevka Nerd Font 16px";
}

window {
    location: center;
    anchor: center;
    width: 700px;
    border: 1px;
    border-color: @outline-variant;
    border-radius: 0px;
    background-color: @surface-container;
    padding: 15px;
}

mainbox {
    background-color: transparent;
    spacing: 8px;
    children: [ inputbar, listview, mode-switcher ];
}

mode-switcher{
    enabled:                     true;
    spacing:                     10px;
    background-color:            transparent;
}
button {
    padding:                     8px 14px;
    border-radius:               0px;
    background-color:            @surface-container-highest;
    text-color:                  @on-surface;
    cursor:                      pointer;
}
button selected {
    background-color:            @primary;
    text-color:                  @on-primary;
}


inputbar {
    background-color: @surface-container-highest;
    border-radius: 0px;
    padding: 8px 14px;
    spacing: 10px;
    children: [ entry ];
}

prompt {
    enabled: false;
}

entry {
    background-color: transparent;
    text-color: @on-surface-variant;
    placeholder: "Search...";
    placeholder-color: @on-surface-variant;
    expand: true;
}

listview {
    background-color: transparent;
    border: 0;
    padding: 2px;
    margin: 0;
    spacing: 10px;
    columns: 1;
    lines: 6;
    cycle: false;
    dynamic: false;
    fixed-height: false;
    layout: vertical;
    scrollbar: false;
}

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    background-color: @surface-container-high;
    border-radius: 0px;
    padding: 8px 12px;
    margin: 0;
    spacing: 10px;
    text-color: @on-surface-variant;
}

element-icon {
    background-color: transparent;
    size: 28px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: none;
    expand: true;
    vertical-align: 0.5;
    format: "{text}";
}

element normal.normal {
    background-color: transparent;
    text-color: @on-surface-variant;
}

element alternate.normal {
    background-color: transparent;
    text-color: @on-surface-variant;
}

element selected.normal {
    background-color: @surface-container-high;
    text-color: @primary;
}

element normal.active {
    background-color: inherit;
    text-color: @tertiary;
}

element selected.active {
    background-color: @surface-container-high;
    text-color: @primary;
}

element normal.urgent,
element selected.urgent {
    background-color: @error;
    text-color: @on-error;
}

element alternate.urgent {
    background-color: @error;
    text-color: @on-error;
}

scrollbar {
    enabled: false;
}

message {
    background-color: transparent;
}

textbox {
    background-color: @surface-container;
    text-color: @error;
}
