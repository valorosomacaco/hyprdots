@import "colors.rasi"

* {
    font: "Google Sans Flex 16px";
}

window {
    location: center;
    anchor: center;
    width: 26%;
    border: 1px;
    border-color: @outline-variant;
    border-radius: 32px;
    background-color: @surface-container;
    padding: 15px;
}

mainbox {
    background-color: transparent;
    spacing: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @surface-container-highest;
    border-radius: 999px;
    padding: 8px 14px;
    spacing: 10px;
    children: [ entry ];
}

prompt {
    enabled: false;
}

entry {
    background-color: transparent;
    text-color: @on-surface-variant;
    placeholder: "Search...";
    placeholder-color: @on-surface-variant;
    expand: true;
}

listview {
    background-color: transparent;
    border: 0;
    padding: 2px;
    margin: 0;
    spacing: 10px;
    columns: 1;
    lines: 8;
    cycle: false;
    dynamic: true;
    fixed-height: true;
    layout: vertical;
    scrollbar: false;
}

element {
    orientation: horizontal;
    children: [ element-text ];
    background-color: @surface-container-high;
    border-radius: 999px;
    padding: 8px 12px;
    margin: 0;
    spacing: 10px;
    text-color: @on-surface-variant;
}

element-icon {
    background-color: transparent;
    size: 1.1em;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: none;
    expand: true;
    vertical-align: 0.5;
    format: "{text}";
}

element normal.normal {
    background-color: @surface-container-high;
    text-color: @on-surface-variant;
}

element alternate.normal {
    background-color: @surface-container-high;
    text-color: @on-surface-variant;
}

element selected.normal {
    background-color: @primary;
    text-color: @on-primary;
}

element normal.active {
    background-color: @primary;
    text-color: @on-primary;
}

element selected.active {
    background-color: @primary;
    text-color: @on-primary;
}

element normal.urgent,
element selected.urgent {
    background-color: @error;
    text-color: @on-error;
}

element alternate.urgent {
    background-color: @error;
    text-color: @on-error;
}

scrollbar {
    enabled: false;
}

message {
    background-color: transparent;
}

textbox {
    background-color: @surface-container;
    text-color: @error;
}

