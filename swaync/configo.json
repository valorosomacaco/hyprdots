{
    "$schema": "/etc/xdg/swaync/configSchema.json",

    "positionX": "right",
    "positionY": "top",

    "control-center-margin-top": 10,
    "control-center-margin-bottom": 10,
    "control-center-margin-right": 10,
    "control-center-margin-left": 10,
    "control-center-width": 340,
    "control-center-height": 700,

    "notification-window-width": 340,
    "notification-icon-size": 48,
    "notification-body-image-height": 100,
    "notification-body-image-width": 200,

    "timeout": 6,
    "timeout-low": 4,
    "timeout-critical": 0,

    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": true,
    "script-fail-notify": true,

    "widgets": [
        "title",
        "dnd",
        "buttons-grid",
        "volume",
        "backlight",
        "notifications"
    ],

    "widget-config": {
        "title": {
            "text": "Notifiche",
            "clear-all-button": true,
            "button-text": "pulisci tutto"
        },
        "dnd": {
            "text": "Non disturbare"
        },
        "buttons-grid": {
            "actions": [
                { "label": "󰖩", "command": "nm-connection-editor" },
                { "label": "󰂯", "command": "blueman-manager" },
                { "label": "󰖨", "command": "swaync-client -db" },
                { "label": "󰀝", "command": "systemctl poweroff" }
            ]
        },
        "volume": {
            "label": "󰕾"
        },
        "backlight": {
            "label": "󰃟"
        }
    }
}

